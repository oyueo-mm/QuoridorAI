{
  "name": "quoridor-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run bench:search",
    "bench:search": "vitest run --config vitest.bench.config.ts bench/search.bench.test.ts",
    "bench:mcts": "vitest run --config vitest.bench.config.ts bench/mcts.bench.test.ts",
    "bench:mcts-steps": "vitest run --config vitest.bench.config.ts bench/mcts-improvement.test.ts",
    "bench:mcts-diagnosis": "vitest run --config vitest.bench.config.ts bench/mcts-diagnosis.test.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
